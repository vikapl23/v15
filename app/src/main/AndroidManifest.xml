<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- ЛР3: доступ до інтернету (відправка даних у хмару) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- ЛР3: перевірка, чи є мережа (ConnectivityManager) -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- ЛР4: вібровідгук (VibratorManager / Vibrator). Звичайний дозвіл, запитувати не треба -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- ЛР4: для CameraManager.setTorchMode() дозвіл CAMERA НЕ потрібен,
         бо ми не відкриваємо камеру, а лише вмикаємо спалах -->

    <!-- Bluetooth для Android 12+ (API 31+): сканування і підключення.
         neverForLocation — ми не визначаємо місцезнаходження за BLE-маяками. -->
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!-- Старі дозволи для API < 31 (Android 11 і нижче) -->
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />
    <!-- На API < 31 BLE-сканування без дозволу на геолокацію не повертає результатів -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!-- BLE і акселерометр бажані, але не обов'язкові: емуляція працює і без них -->
    <uses-feature
        android:name="android.hardware.bluetooth_le"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.sensor.accelerometer"
        android:required="false" />
    <!-- ЛР4: спалах бажаний, але не обов'язковий — без нього ліхтарик віртуальний -->
    <uses-feature
        android:name="android.hardware.camera.flash"
        android:required="false" />

    <application
        android:name=".SmartVibrationApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.VibrationAnalyzer">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
